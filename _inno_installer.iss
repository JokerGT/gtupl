; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "GTUpl"
#define MyAppVersion "1.1.6"
#define MyAppPublisher "JokerGT"
#define MyAppExeName "gtupl.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{A253360C-6564-481E-8AB2-2E828C06CFBD}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={userappdata}\{#MyAppName}
DisableDirPage=no
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
; Remove the following line to run in administrative install mode (install for all users).
PrivilegesRequired=lowest
OutputBaseFilename=GTUpl_Installer
SolidCompression=yes
WizardStyle=classic windows11

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "dist\gtupl.dist\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
Type: files; Name: "{app}\logs\*.log"
Type: files; Name: "{app}\history.enc"
Type: files; Name: "{app}\preferences.ini"

[Dirs]
Name: "{app}\logs"; Flags: uninsalwaysuninstall

[Registry]
Root: HKCU; Subkey: "SOFTWARE\GTUpl"; ValueType: string; ValueName: "Version"; ValueData: "{#MyAppVersion}"; Flags: uninsdeletekeyifempty uninsdeletevalue
Root: HKCU; Subkey: "SOFTWARE\GTUpl"; ValueType: string; ValueName: "InstallPath"; ValueData: "{app}"; Flags: uninsdeletekeyifempty uninsdeletevalue

[Code]
// Helper function to compare semantic version strings numerically (e.g., 1.1.5 vs 1.1.10)
function CompareVersions(V1, V2: String): Integer;
var
  P1, P2, N1, N2: Integer;
  S1, S2: String;
begin
  Result := 0;
  S1 := V1;
  S2 := V2;
  while (Result = 0) and ((S1 <> '') or (S2 <> '')) do
  begin
    P1 := Pos('.', S1);
    if P1 > 0 then
    begin
      N1 := StrToIntDef(Copy(S1, 1, P1 - 1), 0);
      S1 := Copy(S1, P1 + 1, Length(S1));
    end
    else if S1 <> '' then
    begin
      N1 := StrToIntDef(S1, 0);
      S1 := '';
    end
    else
      N1 := 0;

    P2 := Pos('.', S2);
    if P2 > 0 then
    begin
      N2 := StrToIntDef(Copy(S2, 1, P2 - 1), 0);
      S2 := Copy(S2, P2 + 1, Length(S2));
    end
    else if S2 <> '' then
    begin
      N2 := StrToIntDef(S2, 0);
      S2 := '';
    end
    else
      N2 := 0;

    if N1 > N2 then
      Result := 1
    else if N1 < N2 then
      Result := -1;
  end;
end;

// Version check happens early before any UI is built
function InitializeSetup(): Boolean;
var
  ExistingVersion: String;
begin
  Result := True; // Proceed by default

  if RegQueryStringValue(HKCU, 'SOFTWARE\GTUpl', 'Version', ExistingVersion) then
  begin
    if CompareVersions(ExistingVersion, '{#MyAppVersion}') >= 0 then
    begin
      if SuppressibleMsgBox(FmtMessage('Version %1 of GTUpl is already installed (you are attempting to install version {#MyAppVersion}). Proceed with the installation?', [ExistingVersion]), mbConfirmation, MB_YESNO, IDNO) = IDNO then
      begin
        Result := False;
      end;
    end;
  end;
end;

// Safe place to modify Wizard elements after they have been initialized
procedure InitializeWizard();
var
  ExistingPath: String;
begin
  if RegQueryStringValue(HKCU, 'SOFTWARE\GTUpl', 'InstallPath', ExistingPath) then
  begin
    if ExistingPath <> '' then
    begin
      WizardForm.DirEdit.Text := ExistingPath;
    end;
  end;
end;